{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/install-evidence-v1.json",
  "title": "Memory Wuxian installer workflow evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "epoch_id", "step_id", "attempt", "evidence_id", "authorization_receipt_sha256", "producer", "invocation", "artifacts", "subjects"],
  "properties": {
    "schema_version": {"const": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "epoch_id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
    "step_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "authorization_receipt_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {"enum": ["command", "test", "ci", "inspection", "evaluator"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "runner", "exit_code", "source_commit", "source_snapshot_sha256"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
