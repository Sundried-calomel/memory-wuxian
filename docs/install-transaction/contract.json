  "steps": [
    {"id": "S01", "title": "Adopt the evidence-first recovery contract and freeze the exact failed candidate evidence", "prerequisites": [], "allowed_paths": ["AGENTS.md", "workflow-governance.json", "docs/capability-admission/v2.20.0-installer-workflow/**", "docs/defect-receipts/**", "docs/install-transaction/**", "docs/retrospectives/install-transaction-workflow.md", "docs/work-contracts/v2.20.0.json", "scripts/install_transaction_*.py", "tests/test_install_transaction_*.py", ".githooks/pre-commit"], "required_evidence": ["defect-preflight", "workflow-governance-check", "capability-admission-receipt", "state-machine-tests", "project-hook-test", "failed-candidate-evidence-freeze"]},
    {"id": "S02", "title": "Inventory every outer installer and the exact packaged production call chain", "prerequisites": ["S01"], "allowed_paths": ["docs/install-transaction/**"], "required_evidence": ["entrypoint-inventory", "packaged-call-chain-map", "single-owner-decision"]},
    {"id": "S03", "title": "Freeze recovery architecture, invariants, and evidence boundaries", "prerequisites": ["S02"], "allowed_paths": ["docs/install-transaction/**", "docs/module-architecture.json", "docs/promotion-reviews/**"], "required_evidence": ["recovery-architecture-contract", "independent-architecture-evaluation"]},
    {"id": "S04", "title": "Build a no-product-write diagnostic harness for the exact failed artifact", "prerequisites": ["S03"], "allowed_paths": ["scripts/install_transaction_diagnostic*.py", "tests/test_install_transaction_diagnostic*.py", "docs/install-transaction/**"], "required_evidence": ["exact-artifact-diagnostic-harness", "no-product-write-proof"]},
    {"id": "S05", "title": "Prove the exact broker-to-controller failure boundary with child diagnostics", "prerequisites": ["S04"], "allowed_paths": ["docs/install-transaction/**", "docs/rehearsals/**"], "required_evidence": ["broker-controller-trace", "exact-root-cause-proof"]},
    {"id": "S06", "title": "Audit ownership, reachability, package membership, and redundancy before repair", "prerequisites": ["S05"], "allowed_paths": ["docs/install-transaction/**", "docs/promotion-reviews/**"], "required_evidence": ["owner-reachability-audit", "package-membership-audit", "redundancy-disposition-table"]},
    {"id": "S07", "title": "Apply one root-cause repair and delete only proven redundant production paths", "prerequisites": ["S06"], "allowed_paths": ["scripts/**", "packaging/windows/**", "tests/**", "docs/install-transaction/**", "pyproject.toml"], "required_evidence": ["minimal-root-cause-diff", "redundant-path-deletion-proof", "defect-rule-conformance"]},
    {"id": "S08", "title": "Prove behavior equivalence and historical installer regression coverage", "prerequisites": ["S07"], "allowed_paths": ["tests/**", "docs/install-transaction/**"], "required_evidence": ["entrypoint-equivalence-tests", "historical-regression-tests", "diff-simplification-review"]},
    {"id": "S09", "title": "Run the complete packaged production chain on a GitHub-hosted ephemeral Windows runner", "prerequisites": ["S08"], "allowed_paths": [".github/workflows/**", "scripts/windows_installer_transaction.py", "scripts/install_windows_transaction.py", "scripts/install_dashboard_shortcut_windows.ps1", "scripts/inspect_dashboard_shortcut_windows.ps1", "tests/**", "docs/defect-receipts/**", "docs/install-transaction/**", "docs/rehearsals/**", "docs/retrospectives/install-transaction-workflow.md", "docs/retrospectives/memory-wuxian-defect-workbook.md"], "required_evidence": ["packaged-chain-rehearsal", "rollback-and-idempotency-receipts", "assertion-diagnostic-receipt", "diagnostic-redaction-receipt"]},
    {"id": "S10", "title": "Run the targeted Unicode, runtime, broker, rollback, and idempotency matrix", "prerequisites": ["S09"], "allowed_paths": ["tests/**", "docs/install-transaction/**"], "required_evidence": ["targeted-test-matrix", "exact-chain-coverage-proof"]},
    {"id": "S11", "title": "Declare v2.20.0 identity, then run clean, v2.15.0 upgrade, repeat-install, and failure-rollback through the exact production chain", "prerequisites": ["S10"], "allowed_paths": ["pyproject.toml", "native-collector/Cargo.toml", "native-collector/Cargo.lock", "CHANGELOG.md", "README*.md", "docs/documentation-contract.json", "tests/test_v219_release_contract.py", "tests/test_v220_release_contract.py", "docs/install-transaction/**", "docs/rehearsals/**"], "required_evidence": ["release-metadata-declared", "exact-production-chain-windows-rehearsals"]},
    {"id": "S12", "title": "Verify task, process, telemetry, watermark, shortcut, focus, and archive pointer effects", "prerequisites": ["S11"], "allowed_paths": ["docs/install-transaction/**", "docs/rehearsals/**"], "required_evidence": ["installed-runtime-effect-receipt"]},
    {"id": "S13", "title": "Freeze committed candidate source and build one uniquely hashed CI installer", "prerequisites": ["S12"], "allowed_paths": [".github/workflows/**", "docs/install-transaction/**", "docs/promotion-reviews/**"], "required_evidence": ["cross-platform-ci", "full-relevant-tests", "independent-candidate-evaluation", "candidate-source-commit", "ci-artifact-sha256"]},
    {"id": "S14", "title": "Install the exact CI artifact on the target Windows device", "prerequisites": ["S13"], "allowed_paths": ["docs/install-transaction/**", "docs/rehearsals/**"], "required_evidence": ["exact-ci-artifact-download", "real-target-upgrade-receipt"]},
    {"id": "S15", "title": "Promote the same bytes to Release and reinstall the official asset", "prerequisites": ["S14"], "allowed_paths": ["CHANGELOG.md", "README*.md", "docs/**", "pyproject.toml"], "required_evidence": ["no-rebuild-proof", "release-asset-sha256-match", "official-asset-reinstall", "independent-final-evaluation", "defect-completion"]}
  ]
