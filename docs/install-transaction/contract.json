  "freeze_points": {
    "architecture": "S03",
    "candidate": "S13",
    "release": "S15"
  },
  "steps": [
    {"id": "S01", "title": "Freeze failed candidate evidence and establish governance", "prerequisites": [], "allowed_paths": ["AGENTS.md", "workflow-governance.json", "docs/install-transaction/**", "docs/retrospectives/install-transaction-workflow.md", "docs/work-contracts/v2.20.0.json", "scripts/install_transaction_*.py", "tests/test_install_transaction_*.py", ".githooks/pre-commit"], "required_evidence": ["defect-preflight", "workflow-governance-check", "state-machine-tests", "project-hook-test"]},
    {"id": "S02", "title": "Inventory every install, update, task, shortcut, and runtime entrypoint", "prerequisites": ["S01"], "allowed_paths": ["docs/install-transaction/**"], "required_evidence": ["entrypoint-inventory", "single-owner-decision"]},
    {"id": "S03", "title": "Freeze the unified manifest, state machine, red lines, and architecture", "prerequisites": ["S02"], "allowed_paths": ["docs/install-transaction/**", "docs/module-architecture.json", "docs/promotion-reviews/**"], "required_evidence": ["architecture-contract", "independent-architecture-evaluation"]},
    {"id": "S04", "title": "Consolidate task XML render, query, and normalization in the Windows adapter", "prerequisites": ["S03"], "allowed_paths": ["scripts/**", "tests/**", "docs/install-transaction/**"], "required_evidence": ["task-xml-byte-tests", "locale-and-encoding-tests"]},
    {"id": "S05", "title": "Implement the minimal allowlisted UAC broker", "prerequisites": ["S04"], "allowed_paths": ["scripts/**", "packaging/windows/**", "tests/**", "docs/install-transaction/**"], "required_evidence": ["uac-allowlist-tests", "cancel-and-denial-tests"]},
    {"id": "S06", "title": "Route Inno, manual install, and auto-update through one transaction controller", "prerequisites": ["S05"], "allowed_paths": ["scripts/**", "packaging/windows/**", "tests/**", "docs/install-transaction/**"], "required_evidence": ["single-controller-contract", "entrypoint-equivalence-tests"]},
    {"id": "S07", "title": "Establish isolated Python runtime and offline dependency validation", "prerequisites": ["S06"], "allowed_paths": ["scripts/**", "packaging/windows/**", "tests/**", "docs/install-transaction/**", "pyproject.toml"], "required_evidence": ["no-path-dependency-test", "offline-runtime-validation"]},
    {"id": "S08", "title": "Establish the cross-version migration registry and v2.15.0 fixtures", "prerequisites": ["S07"], "allowed_paths": ["scripts/**", "tests/**", "docs/install-transaction/**"], "required_evidence": ["migration-registry-tests", "v2.15.0-fixture-rehearsal"]},
    {"id": "S09", "title": "Propagate exact transaction exits and rollback status through every outer installer", "prerequisites": ["S08"], "allowed_paths": ["scripts/**", "packaging/windows/**", "tests/**", "docs/install-transaction/**"], "required_evidence": ["exit-code-propagation-tests", "rollback-journal-tests"]},
    {"id": "S10", "title": "Run targeted manifest, XML, encoding, UAC, permission, rollback, and idempotency tests", "prerequisites": ["S09"], "allowed_paths": ["tests/**", "docs/install-transaction/**"], "required_evidence": ["targeted-test-matrix"]},
    {"id": "S11", "title": "Declare v2.20.0 identity, then run clean, v2.15.0 upgrade, repeat-install, and failure-rollback Windows rehearsals", "prerequisites": ["S10"], "allowed_paths": ["pyproject.toml", "native-collector/Cargo.toml", "native-collector/Cargo.lock", "CHANGELOG.md", "README*.md", "docs/documentation-contract.json", "tests/test_v219_release_contract.py", "tests/test_v220_release_contract.py", "docs/install-transaction/**", "docs/rehearsals/**"], "required_evidence": ["release-metadata-declared", "real-windows-rehearsal-receipts"]},
    {"id": "S12", "title": "Verify task, process, telemetry, watermark, shortcut, focus, and archive pointer effects", "prerequisites": ["S11"], "allowed_paths": ["docs/install-transaction/**", "docs/rehearsals/**"], "required_evidence": ["installed-runtime-effect-receipt"]},
    {"id": "S13", "title": "Freeze committed candidate source and build one uniquely hashed CI installer", "prerequisites": ["S12"], "allowed_paths": [".github/workflows/**", "docs/install-transaction/**", "docs/promotion-reviews/**"], "required_evidence": ["cross-platform-ci", "full-relevant-tests", "independent-candidate-evaluation", "candidate-source-commit", "ci-artifact-sha256"]},
    {"id": "S14", "title": "Install the exact CI artifact on the target Windows device", "prerequisites": ["S13"], "allowed_paths": ["docs/install-transaction/**", "docs/rehearsals/**"], "required_evidence": ["exact-ci-artifact-download", "real-target-upgrade-receipt"]},
    {"id": "S15", "title": "Promote the same bytes to Release and reinstall the official asset", "prerequisites": ["S14"], "allowed_paths": ["CHANGELOG.md", "README*.md", "docs/**", "pyproject.toml"], "required_evidence": ["no-rebuild-proof", "release-asset-sha256-match", "official-asset-reinstall", "independent-final-evaluation", "defect-completion"]}
  ]
}
