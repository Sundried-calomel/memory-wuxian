    "preserve_completed_steps": true,
    "promote_current_worktree_to_baseline": true,
    "invalidate_resumed_and_downstream_receipts": true
  },
  "protected_paths": [
    "AGENTS.md",
    "docs/install-transaction/**",
    "docs/retrospectives/install-transaction-workflow.md",
