{
  "schema_version": 2,
  "source_roots": [
    {"path": "scripts", "extensions": [".py", ".ps1", ".sh"]},
    {"path": "native-collector/src", "extensions": [".rs"]},
    {"path": "packaging", "all_files": true},
    {"path": "dashboard", "extensions": [".html", ".css", ".js"]},
    {"path": "schemas", "extensions": [".json"]},
    {"path": "contracts", "extensions": [".json"]}
  ],
  "modules": [
    {
      "id": "capture-core",
      "architecture_owner": "Capture Core",
      "criticality": "P0",
      "failure_domain": "capture-core",
      "allowed_dependencies": ["platform-foundation"],
      "forbidden_dependencies": [
        "product-shell",
        "control-plane",
        "memory-plane",
        "environment-plane",
        "project-evidence-plane",
        "exchange-plane",
        "product-quality"
      ],
      "forbidden_capabilities": ["control", "memory", "exchange", "environment", "project", "ui", "ai"],
      "patterns": [
        "scripts/collector_lifecycle.py",
        "scripts/collector_runtime_effect_gate.py",
        "native-collector/src/main.rs",
        "native-collector/src/lib.rs",
        "native-collector/src/runtime.rs",
        "native-collector/src/locking.rs",
        "native-collector/src/telemetry.rs",
        "native-collector/src/source/**",
        "native-collector/src/store/**",
        "native-collector/src/bin/memory-wuxian-core-launcher.rs"
      ],
      "expected_patterns": [
        "scripts/collector_lifecycle.py",
        "native-collector/src/lib.rs",
        "native-collector/src/runtime.rs",
        "native-collector/src/locking.rs",
        "native-collector/src/telemetry.rs",
        "native-collector/src/source/**",
        "native-collector/src/store/**",
        "native-collector/src/bin/memory-wuxian-core-launcher.rs"
      ]
    },
    {
      "id": "product-shell",
      "architecture_owner": "Product Shell",
      "criticality": "P2",
      "failure_domain": "product-shell",
      "allowed_dependencies": ["capture-core", "control-plane", "memory-plane", "environment-plane", "project-evidence-plane", "exchange-plane", "platform-foundation"],
      "forbidden_dependencies": [],
      "patterns": [
        "dashboard/**",
        "scripts/auto_update.py",
        "scripts/bootstrap_windows.ps1",
        "scripts/install_*.py",
        "scripts/install_*.ps1",
        "scripts/inspect_dashboard_shortcut_windows.ps1",
        "scripts/install_maintenance_supervisor.py",
        "scripts/migrate_config.py",
        "scripts/memory_cli.py",
        "scripts/memory_dashboard.py",
        "scripts/memory_readonly_http.py",
        "scripts/memory_readonly_mcp.py",
        "scripts/memory_update_governance.py",
        "packaging/macos/MemoryDashboard.swift",
        "packaging/macos/scripts/postinstall",
        "packaging/windows/install.ps1",
        "packaging/windows/uninstall.ps1",
        "native-collector/src/bin/memory-wuxian-dashboard-launcher.rs"
      ]
    },
    {
      "id": "control-plane",
      "architecture_owner": "Control Plane",
      "criticality": "P1",
      "failure_domain": "control-plane",
      "allowed_dependencies": ["capture-core", "product-shell", "memory-plane", "environment-plane", "project-evidence-plane", "exchange-plane", "platform-foundation"],
      "forbidden_dependencies": [],
      "patterns": [
        "scripts/archive_waterline.py",
        "scripts/governance_ai_worker.py",
        "scripts/memory_configuration.py",
        "scripts/memory_diagnostics.py",
        "scripts/memory_jobs.py",
        "scripts/memory_readonly_service.py",
        "scripts/memory_service_state.py",
        "scripts/memory_summary_budget.py",
        "scripts/runtime_effect_gate.py",
        "scripts/maintenance_supervisor.py",
        "scripts/semantic_backfill.py",
        "scripts/semantic_dispatch.py",
        "scripts/semantic_e5_worker.py",
        "scripts/semantic_plan.py",
        "scripts/semantic_worker.py"
      ]
    },
    {
      "id": "memory-plane",
      "architecture_owner": "Memory Plane",
      "criticality": "P1",
      "failure_domain": "memory-plane",
      "allowed_dependencies": ["capture-core", "control-plane", "environment-plane", "project-evidence-plane", "exchange-plane", "platform-foundation"],
      "forbidden_dependencies": ["product-shell"],
      "patterns": [
        "scripts/conversation_titles.py",
        "scripts/daily_metrics.py",
        "scripts/memory_indexing.py",
        "scripts/memory_content_store.py",
        "scripts/memory_guarded_features.py",
        "scripts/token_usage.py"
      ]
    },
    {
      "id": "environment-plane",
      "architecture_owner": "Environment Plane",
      "criticality": "P1",
      "failure_domain": "environment-plane",
      "allowed_dependencies": ["control-plane", "memory-plane", "project-evidence-plane", "exchange-plane", "platform-foundation"],
      "forbidden_dependencies": ["capture-core", "product-shell"],
      "patterns": [
        "scripts/memory_environment*.py",
        "scripts/memory_governance_ai.py",
        "scripts/semantic_runtime_contract.py",
        "contracts/**"
      ]
    },
    {
      "id": "project-evidence-plane",
      "architecture_owner": "Project Evidence Plane",
      "criticality": "P1",
      "failure_domain": "project-evidence-plane",
      "allowed_dependencies": ["control-plane", "memory-plane", "environment-plane", "exchange-plane", "platform-foundation"],
      "forbidden_dependencies": ["capture-core", "product-shell"],
      "patterns": [
        "scripts/memory_project_evidence.py",
        "scripts/memory_project_attachments.py"
      ]
    },
    {
      "id": "exchange-plane",
      "architecture_owner": "Exchange Plane",
      "criticality": "P1",
      "failure_domain": "exchange-plane",
      "allowed_dependencies": ["control-plane", "memory-plane", "environment-plane", "project-evidence-plane", "platform-foundation"],
      "forbidden_dependencies": ["capture-core", "product-shell"],
      "patterns": [
        "scripts/memory_cloud_transport.py",
        "scripts/memory_federation.py",
        "scripts/memory_resumable_sync.py",
        "native-collector/src/bin/memory-wuxian-envelope.rs"
      ]
    },
    {
      "id": "platform-foundation",
      "architecture_owner": "Platform Foundation",
      "criticality": "P0",
      "failure_domain": "platform-foundation",
      "allowed_dependencies": [],
      "forbidden_dependencies": ["capture-core", "product-shell", "control-plane", "memory-plane", "environment-plane", "project-evidence-plane", "exchange-plane"],
      "patterns": [
        "scripts/console_encoding.py",
        "scripts/collector_activation.py",
        "scripts/platform_transaction.py",
        "scripts/platform_*.py",
        "schemas/**"
      ]
    },
    {
      "id": "product-quality",
      "architecture_owner": "Release Evidence Contract",
      "criticality": "P2",
      "failure_domain": "product-quality",
      "allowed_dependencies": ["capture-core", "product-shell", "control-plane", "memory-plane", "environment-plane", "project-evidence-plane", "exchange-plane", "platform-foundation"],
      "forbidden_dependencies": [],
      "patterns": [
        "scripts/build_native_collector.ps1",
        "scripts/build_native_collector.sh",
        "scripts/check_architecture_contract.py",
        "scripts/check_documentation_changes.py",
        "scripts/check_documentation_contract.py",
        "packaging/macos/build_dashboard_app.sh",
        "packaging/macos/build_pkg.sh",
        "packaging/windows/MemoryWuxian.iss",
        "scripts/run_release_rehearsal.py"
      ]
    }
  ],
  "python_dependency_rules": {
    "enforce_module_allowlist": true,
    "forbidden_imports": {
      "capture-core": [
        "anthropic",
        "memory_cli",
        "memory_cloud_transport",
        "memory_dashboard",
        "memory_environment",
        "memory_federation",
        "memory_governance_ai",
        "memory_project_attachments",
        "memory_project_evidence",
        "openai",
        "semantic_dispatch",
        "semantic_worker"
      ],
      "control-plane": ["memory_dashboard"],
      "memory-plane": ["memory_cli", "memory_dashboard"],
      "environment-plane": ["memory_cli", "memory_dashboard"],
      "exchange-plane": ["memory_cli", "memory_dashboard"],
      "platform-foundation": [
        "memory_cli",
        "memory_dashboard",
        "memory_environment",
        "memory_federation",
        "memory_cloud_transport"
      ]
    }
  },
  "rust_capability_rules": {
    "symbols": {
      "ai": ["anthropic", "async_openai", "openai"],
      "control": ["governance", "maintenance", "scheduler"],
      "environment": ["environment"],
      "exchange": ["cloud", "envelope", "federation", "reqwest", "ssh2"],
      "memory": ["indexing", "retrieval", "semantic_dispatch", "semantic_worker", "summary", "summaries"],
      "project": ["project"],
      "ui": ["egui", "iced", "tao", "webview2", "wry"]
    }
  }
}
