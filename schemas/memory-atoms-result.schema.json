{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/memory-atoms-result-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "job_id",
    "source_sha256",
    "atoms",
    "relations"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "atoms": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "atom_type",
          "statement",
          "epistemic_status",
          "scope",
          "source_message_ids"
        ],
        "properties": {
          "local_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "atom_type": {
            "type": "string",
            "enum": [
              "work_fact",
              "work_task",
              "work_method",
              "work_artifact"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "epistemic_status": {
            "type": "string",
            "enum": [
              "explicit_fact",
              "accepted_decision",
              "proposal",
              "open_question",
              "uncertain",
              "withdrawn"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source_message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_local_id",
          "to_local_id",
          "relation_type",
          "source_message_ids"
        ],
        "properties": {
          "from_local_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "to_local_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "relation_type": {
            "type": "string",
            "enum": [
              "supports",
              "duplicates",
              "revises",
              "contradicts",
              "supersedes"
            ]
          },
          "source_message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
