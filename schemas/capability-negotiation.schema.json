{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/capability-negotiation.schema.json",
  "title": "Memory Wuxian capability negotiation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "negotiation_version",
    "status",
    "compatible",
    "reason_codes",
    "findings",
    "local_offer_sha256",
    "remote_offer_sha256",
    "blocks_existing_sync",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "negotiation_version": {"const": 1},
    "status": {
      "enum": ["compatible", "incompatible", "unknown-legacy"]
    },
    "compatible": {"type": ["boolean", "null"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reasonCode"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "local_offer_sha256": {"$ref": "#/$defs/sha256"},
    "remote_offer_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "blocks_existing_sync": {"const": false},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation",
        "trust",
        "permission_expansion",
        "synchronization"
      ],
      "properties": {
        "installation": {"const": false},
        "trust": {"const": false},
        "permission_expansion": {"const": false},
        "synchronization": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "versionOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"
    },
    "reasonCode": {
      "enum": [
        "compatible",
        "unknown-legacy-offer",
        "product-mismatch",
        "peer-product-version-too-old",
        "peer-platform-unsupported",
        "required-runtime-missing",
        "runtime-version-too-old",
        "required-protocol-missing",
        "protocol-version-too-old",
        "required-interface-missing",
        "interface-version-too-old"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "side",
        "category",
        "subject",
        "offered_version",
        "required_version"
      ],
      "properties": {
        "reason_code": {"$ref": "#/$defs/reasonCode"},
        "side": {"enum": ["local", "remote"]},
        "category": {
          "enum": ["product", "platform", "runtime", "protocol", "interface"]
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "offered_version": {"$ref": "#/$defs/versionOrNull"},
        "required_version": {"$ref": "#/$defs/versionOrNull"}
      }
    }
  }
}
