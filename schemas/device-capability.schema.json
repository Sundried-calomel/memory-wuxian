{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/device-capability.schema.json",
  "title": "Memory Wuxian device capability offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "offer_version",
    "product",
    "platform",
    "supported_peer_platforms",
    "runtimes",
    "protocols",
    "interfaces"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "offer_version": {"const": 1},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "minimum_peer_version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "version": {"$ref": "#/$defs/version"},
        "minimum_peer_version": {"$ref": "#/$defs/version"}
      }
    },
    "platform": {"$ref": "#/$defs/platform"},
    "supported_peer_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/platform"}
    },
    "runtimes": {"$ref": "#/$defs/capabilityList"},
    "protocols": {"$ref": "#/$defs/capabilityList"},
    "interfaces": {"$ref": "#/$defs/capabilityList"}
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"
    },
    "platform": {
      "enum": ["macos", "windows", "linux"]
    },
    "capabilityList": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"}
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "minimum_peer_version", "required"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "version": {"$ref": "#/$defs/version"},
        "minimum_peer_version": {"$ref": "#/$defs/version"},
        "required": {"type": "boolean"}
      }
    }
  }
}
