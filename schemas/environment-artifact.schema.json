{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/environment-artifact.schema.json",
  "title": "Memory Wuxian environment artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "object_class",
    "scope",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]{2,191}$"
    },
    "object_class": {
      "enum": [
        "global-rule",
        "project-rule",
        "global-skill",
        "project-skill",
        "global-runtime-contract"
      ]
    },
    "scope": {"enum": ["global", "project"]},
    "project_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "display_name": {"type": ["string", "null"], "maxLength": 256},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "project"}}},
      "then": {
        "required": ["project_id"],
        "properties": {"project_id": {"type": "string"}}
      },
      "else": {"properties": {"project_id": {"type": "null"}}}
    }
  ]
}
