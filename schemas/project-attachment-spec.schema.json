{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/project-attachment-spec.schema.json",
  "title": "Memory Wuxian project attachment specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "source_root", "conversation_ids", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "source_root": {"type": "string", "minLength": 1},
    "conversation_ids": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9._-]+:[^\\r\\n]{1,240}$"}
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["source-paper", "supplement", "presentation", "report", "figure", "table", "other-deliverable"]}
        }
      }
    }
  }
}
