{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/environment-profile-pointer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation_id", "generation_sha256", "profile_id", "profile_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "generation_id": {"type": "string", "pattern": "^generation:[0-9a-f]{64}$"},
    "generation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "pattern": "^profile:[0-9a-f]{64}$"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
