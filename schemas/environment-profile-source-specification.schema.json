{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/environment-profile-source-specification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "skills", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "platform": {"enum": ["windows", "macos", "linux"]},
    "skills": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["installation_id", "provider_type", "provider_id", "applicable_platforms"],
        "properties": {
          "installation_id": {"type": "string", "pattern": "^(skill|system|plugin):[a-z0-9][a-z0-9._-]{1,183}$"},
          "provider_type": {"enum": ["user-managed", "system-bundled", "plugin-managed"]},
          "provider_id": {"type": "string", "pattern": "^(user(:[a-z0-9][a-z0-9._-]{1,119})?|system:[a-z0-9][a-z0-9._-]{1,119}|plugin:[a-z0-9][a-z0-9._-]{1,119})$"},
          "applicable_platforms": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["windows", "macos", "linux"]}},
          "declared_version": {"type": ["string", "null"], "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,127}$"},
          "root": {"type": "string", "minLength": 1},
          "incomplete_reason": {"enum": ["not-installed", "platform-inapplicable", "provider-unavailable"]}
        },
        "oneOf": [
          {"required": ["root"], "not": {"required": ["incomplete_reason"]}},
          {"required": ["incomplete_reason"], "not": {"required": ["root"]}}
        ],
        "allOf": [
          {
            "if": {"properties": {"provider_type": {"const": "user-managed"}}},
            "then": {"properties": {"installation_id": {"pattern": "^skill:[a-z0-9][a-z0-9._-]{1,183}$"}, "provider_id": {"pattern": "^user(:[a-z0-9][a-z0-9._-]{1,119})?$"}}}
          },
          {
            "if": {"properties": {"provider_type": {"const": "system-bundled"}}},
            "then": {"properties": {"installation_id": {"pattern": "^system:[a-z0-9][a-z0-9._-]{1,183}$"}, "provider_id": {"pattern": "^system:[a-z0-9][a-z0-9._-]{1,119}$"}}}
          },
          {
            "if": {"properties": {"provider_type": {"const": "plugin-managed"}}},
            "then": {"properties": {"installation_id": {"pattern": "^plugin:[a-z0-9][a-z0-9._-]{1,183}$"}, "provider_id": {"pattern": "^plugin:[a-z0-9][a-z0-9._-]{1,119}$"}}}
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "path"],
        "properties": {
          "rule_id": {"enum": ["global-agents", "global-agents-override"]},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
