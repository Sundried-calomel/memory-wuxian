{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-wuxian.local/schemas/project-evidence-owner.schema.json",
  "title": "Memory Wuxian device-local project evidence owner",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "project_id", "title", "source_root", "files", "enabled"],
  "properties": {
    "format": {"const": "memory-wuxian-project-evidence-owner-v1"},
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "source_root": {"type": "string", "minLength": 1},
    "enabled": {"const": true},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["project-rule", "status", "next-plan", "decision", "qa", "daily-report", "weekly-report", "phase-report", "template", "figure", "table", "artifact-index", "other-evidence"]}
        }
      }
    }
  }
}
