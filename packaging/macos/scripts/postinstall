#!/bin/bash
set -euo pipefail

console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ -z "$console_user" || "$console_user" == "root" || "$console_user" == "loginwindow" ]]; then
  echo "MemoryWuxian requires a logged-in macOS user." >&2
  exit 1
fi

user_home="$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/awk '{print $2}')"
source_root="/Library/Application Support/MemoryWuxian/skill"
skill_root="$user_home/.codex/skills/memory-wuxian"
archive_root="$user_home/Documents/MemoryWuxianArchive"
sessions_root="$user_home/.codex/sessions"
active_root_pointer="$user_home/.codex/memory-wuxian-active-root.txt"
if [[ -f "$active_root_pointer" ]]; then
  preserved_archive_root="$(/bin/cat "$active_root_pointer")"
  if [[ "$preserved_archive_root" == *$'\n'* ]]; then
    echo "MemoryWuxian active archive pointer must contain exactly one path." >&2
    exit 1
  fi
  if [[ -z "$preserved_archive_root" || "$preserved_archive_root" != /* || ! -d "$preserved_archive_root" ]]; then
    echo "MemoryWuxian active archive pointer is invalid: $active_root_pointer" >&2
    exit 1
  fi
  archive_root="$preserved_archive_root"
fi

find_python() {
  local candidate
  for candidate in \
    "/opt/homebrew/bin/python3" \
    "/usr/local/bin/python3" \
    "/usr/bin/python3"; do
    if [[ -x "$candidate" ]] && "$candidate" -c 'import sys; raise SystemExit(not ((3, 14) <= sys.version_info < (3, 15)))' 2>/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  while IFS= read -r candidate; do
    if [[ -x "$candidate" ]] && "$candidate" -c 'import sys; raise SystemExit(not ((3, 14) <= sys.version_info < (3, 15)))' 2>/dev/null; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(/usr/bin/find "$user_home/.cache/codex-runtimes" -type f -path '*/dependencies/python/bin/python3' -perm -111 -print 2>/dev/null || true)
  return 1
}

python_executable="$(find_python || true)"
codex_cli="/Applications/ChatGPT.app/Contents/Resources/codex"
if [[ ! -x "$codex_cli" ]]; then
  codex_cli="$user_home/.codex/.sandbox-bin/codex"
fi
if [[ -z "$python_executable" || ! -x "$python_executable" ]]; then
  echo "MemoryWuxian requires Python 3.14.x. Open Codex once, then run this installer again." >&2
  exit 1
fi
if [[ ! -x "$codex_cli" ]]; then
  echo "MemoryWuxian requires the Codex desktop application." >&2
  exit 1
fi
if ! /usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" \
  "$python_executable" -c 'import yaml; assert yaml.__version__.split(".", 1)[0] == "6"' 2>/dev/null; then
  bundled_yaml="$source_root/vendor/yaml"
  runtime_root="$user_home/.codex/runtimes/memory-wuxian-python-3.14"
  if [[ ! -f "$bundled_yaml/__init__.py" ]]; then
    echo "MemoryWuxian package is missing its offline PyYAML runtime." >&2
    exit 1
  fi
  /usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" \
    "$python_executable" -m venv --without-pip --clear "$runtime_root"
  runtime_python="$runtime_root/bin/python"
  site_packages="$(/usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" \
    "$runtime_python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
  /usr/bin/sudo -u "$console_user" /bin/mkdir -p "$site_packages/yaml"
  /usr/bin/sudo -u "$console_user" /usr/bin/rsync -a --delete \
    "$bundled_yaml/" "$site_packages/yaml/"
  python_executable="$runtime_python"
  if ! /usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" \
    "$python_executable" -c 'import yaml; assert yaml.__version__.split(".", 1)[0] == "6"' 2>/dev/null; then
    echo "MemoryWuxian isolated PyYAML runtime verification failed." >&2
    exit 1
  fi
fi

/usr/bin/install -d -o "$console_user" -g staff "$user_home/.codex"
if [[ ! -e "$archive_root" ]]; then
  /usr/bin/install -d -o "$console_user" -g staff "$archive_root"
fi
if [[ ! -d "$archive_root" ]]; then
  echo "MemoryWuxian archive root is not a directory: $archive_root" >&2
  exit 1
fi
archive_root="$(cd "$archive_root" && /bin/pwd -P)"
if [[ ! -e "$sessions_root" ]]; then
  /usr/bin/install -d -o "$console_user" -g staff "$sessions_root"
fi
if [[ ! -d "$sessions_root" ]]; then
  echo "MemoryWuxian sessions root is not a directory: $sessions_root" >&2
  exit 1
fi

if [[ ! -f "$archive_root/state.json" ]]; then
  if [[ -n "$(/bin/ls -A "$archive_root")" ]]; then
    echo "MemoryWuxian refuses to initialize a non-empty unknown archive: $archive_root" >&2
    exit 1
  fi
  /usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" \
    "$python_executable" "$source_root/scripts/memory_cli.py" \
    --root "$archive_root" --config "$source_root/config.yaml" init >/dev/null
fi

/usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" \
  "$python_executable" "$source_root/scripts/install_macos_transaction.py" \
  --source-root "$source_root" \
  --skill-root "$skill_root" \
  --archive-root "$archive_root" \
  --sessions-root "$sessions_root" \
  --python-executable "$python_executable" \
  --codex-cli "$codex_cli" >/dev/null

node_display_name="$(/usr/sbin/scutil --get ComputerName 2>/dev/null || /bin/hostname)"
/usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" \
  "$python_executable" "$skill_root/scripts/memory_cli.py" \
  --root "$archive_root" --config "$skill_root/config.yaml" \
  init-node --display-name "$node_display_name" >/dev/null

/usr/bin/sudo -u "$console_user" /usr/bin/env HOME="$user_home" \
  "$python_executable" "$skill_root/scripts/install_auto_update.py" \
  --skill-root "$skill_root" \
  --python-executable "$python_executable" >/dev/null

committed_archive_root="$(/bin/cat "$active_root_pointer")"
if [[ "$committed_archive_root" == *$'\n'* || "$committed_archive_root" != "$archive_root" ]]; then
  echo "MemoryWuxian transaction did not commit the requested archive root." >&2
  exit 1
fi

exit 0
